# ========================================================
# YOUPI MERN FRONTEND CONFIGURATION (.env)
# ========================================================

# Backend Render API URL
# In local dev: empty or http://localhost:5050
# In Vercel prod: https://youpi-mern-backend.onrender.com
VITE_API_BASE=http://localhost:5050

# YOUPI PG Checkout Host (where youpi.js is hosted)
# In local dev: http://localhost:7000
# In production: https://pay.yourdomain.com (your deployed checkout portal)
VITE_YOUPI_HOST=http://localhost:7000

# Merchant Public Key from YOUPI Merchant Admin (Default: 00000000-0000-0000-0000-000000000001)
VITE_YOUPI_KEY=00000000-0000-0000-0000-000000000001
