# ========================================================
# YOUPI MERN E-COMMERCE BACKEND CONFIGURATION (.env)
# ========================================================

# Server Port
PORT=5050
NODE_ENV=production

# MongoDB Database Connection
# In local dev: mongodb://127.0.0.1:27017/youpi_ecommerce
# In Render prod: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/youpi_ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:your_secure_password@cluster0.mongodb.net/youpi_ecommerce?retryWrites=true&w=majority

# YOUPI PG Webhook Secret (MUST match your Merchant Admin Webhooks secret)
# Default dev key: youpi_webhook_secret_default_key_32c
YOUPI_WEBHOOK_SECRET=youpi_webhook_secret_default_key_32c

# Vercel Frontend Allowed Origin for CORS
FRONTEND_URL=https://your-mern-store.vercel.app
